{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "traceability.schema.json",
  "title": "PostgreSQL STIG Traceability Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "controls"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "content_policy"],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "content_policy": {
          "type": "string"
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "rule_id",
          "stig_id",
          "severity",
          "cci_refs",
          "status",
          "implementation_owner",
          "validation_owner",
          "deployment_responsibility",
          "implemented_by",
          "validated_by",
          "notes"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "pattern": "^V-[0-9]+$"
          },
          "rule_id": {
            "type": "string",
            "pattern": "^SV-[0-9]+r[0-9]+_rule$"
          },
          "stig_id": {
            "type": "string"
          },
          "severity": {
            "enum": ["low", "medium", "high"]
          },
          "cci_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^CCI-[0-9]+$"
            }
          },
          "status": {
            "enum": [
              "not_yet_reviewed",
              "image_enforced",
              "deployment_owned",
              "validation_only",
              "manual",
              "exception"
            ]
          },
          "implementation_owner": {
            "enum": [
              "unassigned",
              "image",
              "deployment",
              "validation_profile",
              "overlay",
              "documentation",
              "manual",
              "exception"
            ]
          },
          "validation_owner": {
            "enum": [
              "unassigned",
              "image",
              "deployment",
              "validation_profile",
              "overlay",
              "documentation",
              "manual",
              "exception"
            ]
          },
          "deployment_responsibility": {
            "enum": [
              "undetermined",
              "none",
              "kubernetes",
              "operator",
              "organization_policy",
              "identity_and_access",
              "networking",
              "secrets",
              "manual"
            ]
          },
          "implemented_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "validated_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
