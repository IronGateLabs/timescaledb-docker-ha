#!/usr/bin/env python3
"""Validate STIG review artifacts for path, secret, and prose-boundary hygiene."""

import re
import sys
from pathlib import Path


REVIEW_ARTIFACTS = [
    Path("stig/postgres16-manual-control-reduction-review.md"),
]
PROHIBITED_PATTERNS = [
    re.compile(r"/Users/[^\s\"')]+"),
    re.compile(r"/home/[^\s\"')]+"),
    re.compile(r"(?i)password\s*[:=]"),
    re.compile(r"(?i)secret\s*[:=]"),
    re.compile(r"(?i)token\s*[:=]"),
    re.compile(r"(?i)private[_ -]?key"),
]
PROHIBITED_PROSE_LABELS = {
    "title",
    "description",
    "discussion",
    "check",
    "check_content",
    "fix",
    "fix_text",
    "fixtext",
    "vuln_discussion",
}


def fail(message):
    print(f"review artifact check failed: {message}", file=sys.stderr)
    return 1


def main():
    checked = 0
    for artifact in REVIEW_ARTIFACTS:
        if not artifact.exists():
            continue
        text = artifact.read_text()
        checked += 1
        for pattern in PROHIBITED_PATTERNS:
            if pattern.search(text):
                return fail(f"{artifact} matched prohibited pattern: {pattern.pattern}")
        for label in PROHIBITED_PROSE_LABELS:
            if re.search(rf"(?im)^\s*{re.escape(label)}\s*:", text):
                return fail(f"{artifact} contains prohibited prose-bearing label: {label}")

    print(f"review artifact check passed: {checked} artifacts")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
