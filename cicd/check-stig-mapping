#!/usr/bin/env python3
"""Validate PostgreSQL 16 STIG control mapping metadata."""

import json
import re
import sys
from pathlib import Path


TRACEABILITY = Path("stig/postgres16-v1r2-traceability.json")
MAPPING = Path("stig/postgres16-control-mapping.json")

REQUIRED_MAPPING_FIELDS = {
    "control_id",
    "stig_id",
    "severity",
    "cci_refs",
    "mapping_status",
    "legacy_control_ids",
    "candidate_legacy_control_ids",
    "candidate_srg_ids",
    "candidate_basis",
    "candidate_warnings",
    "overlay_checks",
    "automation_status",
    "container_validation",
    "implementation_owner",
    "validation_owner",
    "deployment_responsibility",
    "notes",
}
ALLOWED_MAPPING_STATUS = {
    "unmapped",
    "direct_match",
    "mapped",
    "replaced_by_overlay",
    "manual_only",
    "deployment_owned",
    "exception",
}
ALLOWED_AUTOMATION_STATUS = {
    "not_yet_assessed",
    "automated",
    "partially_automated",
    "manual",
    "deployment_owned",
    "exception",
}
ALLOWED_CONTAINER_VALIDATION = {
    "not_yet_assessed",
    "supported",
    "partial",
    "not_supported",
}
ALLOWED_OWNER = {
    "unassigned",
    "image",
    "deployment",
    "validation_profile",
    "overlay",
    "documentation",
    "manual",
    "exception",
}
ALLOWED_DEPLOYMENT_RESPONSIBILITY = {
    "undetermined",
    "none",
    "kubernetes",
    "operator",
    "organization_policy",
    "identity_and_access",
    "networking",
    "secrets",
    "manual",
}
PROHIBITED_STRING_PATTERNS = [
    re.compile(r"/Users/[^\s\"']+"),
    re.compile(r"/home/[^p][^\s\"']*"),
    re.compile(r"(?i)password\s*[:=]"),
    re.compile(r"(?i)secret\s*[:=]"),
    re.compile(r"(?i)token\s*[:=]"),
    re.compile(r"(?i)private[_ -]?key"),
]


def fail(message):
    print(f"mapping check failed: {message}", file=sys.stderr)
    return 1


def walk_strings(value):
    if isinstance(value, dict):
        for key, item in value.items():
            yield str(key)
            yield from walk_strings(item)
    elif isinstance(value, list):
        for item in value:
            yield from walk_strings(item)
    elif isinstance(value, str):
        yield value


def main():
    if not TRACEABILITY.exists():
        return fail(f"missing {TRACEABILITY}")
    if not MAPPING.exists():
        return fail(f"missing {MAPPING}")

    traceability = json.loads(TRACEABILITY.read_text())
    mapping = json.loads(MAPPING.read_text())
    traceability_ids = {control["control_id"] for control in traceability["controls"]}

    if mapping.get("schema_version") != 1:
        return fail("schema_version must be 1")
    if not isinstance(mapping.get("mappings"), list):
        return fail("mappings must be a list")

    for value in walk_strings(mapping):
        for pattern in PROHIBITED_STRING_PATTERNS:
            if pattern.search(value):
                return fail(f"prohibited string pattern matched: {pattern.pattern}")

    mapping_ids = set()
    for index, item in enumerate(mapping["mappings"], start=1):
        missing = REQUIRED_MAPPING_FIELDS - set(item)
        extra = set(item) - REQUIRED_MAPPING_FIELDS
        if missing:
            return fail(f"mapping {index} missing fields: {sorted(missing)}")
        if extra:
            return fail(f"mapping {index} has unsupported fields: {sorted(extra)}")
        control_id = item["control_id"]
        if control_id in mapping_ids:
            return fail(f"duplicate control_id: {control_id}")
        mapping_ids.add(control_id)
        if control_id not in traceability_ids:
            return fail(f"mapping references unknown control_id: {control_id}")
        if item["mapping_status"] not in ALLOWED_MAPPING_STATUS:
            return fail(f"invalid mapping_status for {control_id}")
        if item["automation_status"] not in ALLOWED_AUTOMATION_STATUS:
            return fail(f"invalid automation_status for {control_id}")
        if item["container_validation"] not in ALLOWED_CONTAINER_VALIDATION:
            return fail(f"invalid container_validation for {control_id}")
        if item["implementation_owner"] not in ALLOWED_OWNER:
            return fail(f"invalid implementation_owner for {control_id}")
        if item["validation_owner"] not in ALLOWED_OWNER:
            return fail(f"invalid validation_owner for {control_id}")
        if item["deployment_responsibility"] not in ALLOWED_DEPLOYMENT_RESPONSIBILITY:
            return fail(f"invalid deployment_responsibility for {control_id}")
        for legacy_id in item["legacy_control_ids"]:
            if not re.fullmatch(r"V-\d+", legacy_id):
                return fail(f"invalid legacy control id for {control_id}: {legacy_id}")
        for legacy_id in item["candidate_legacy_control_ids"]:
            if not re.fullmatch(r"V-\d+", legacy_id):
                return fail(f"invalid candidate legacy control id for {control_id}: {legacy_id}")
        for cci_ref in item["cci_refs"]:
            if not re.fullmatch(r"CCI-\d+", cci_ref):
                return fail(f"invalid CCI ref for {control_id}: {cci_ref}")
        for srg_id in item["candidate_srg_ids"]:
            if not re.fullmatch(r"SRG-[A-Z]+-\d+-[A-Z]+-\d+", srg_id):
                return fail(f"invalid candidate SRG id for {control_id}: {srg_id}")
        if not isinstance(item["candidate_basis"], list):
            return fail(f"candidate_basis must be a list for {control_id}")
        if not isinstance(item["candidate_warnings"], dict):
            return fail(f"candidate_warnings must be an object for {control_id}")

    if mapping_ids != traceability_ids:
        missing = sorted(traceability_ids - mapping_ids)
        extra = sorted(mapping_ids - traceability_ids)
        return fail(f"mapping coverage mismatch missing={missing[:5]} extra={extra[:5]}")

    print(f"mapping check passed: {len(mapping_ids)} controls")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
